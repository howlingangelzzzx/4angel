services:
  - type: web
    name: 4angel
    runtime: python
    plan: free
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn app:app --workers 2 --bind 0.0.0.0:$PORT
    envVars:
      - key: DATA_DIR
        value: /var/data
    disk:
      name: 4angel-data
      mountPath: /var/data
      sizeGB: 1
import os
import sqlite3
import secrets
from pathlib import Path
from datetime import datetime, timezone
from flask import (
    Flask, request, redirect, url_for,
    render_template_string, abort, send_from_directory
)
from werkzeug.utils import secure_filename

app = Flask(__name__)

DATA = Path(os.environ.get("DATA_DIR", "./data"))
UPLOADS = DATA / "uploads"
DATA.mkdir(parents=True, exist_ok=True)
UPLOADS.mkdir(parents=True, exist_ok=True)

DB = DATA / "4angel.db"
app.config["MAX_CONTENT_LENGTH"] = 5 * 1024 * 1024

BOARDS = {
    "b": ("Random", "Anything goes, within the site rules."),
    "tech": ("Technology", "Computers, software, and hardware."),
    "games": ("Video Games", "Games, gaming news, and discussion."),
    "art": ("Art", "Drawings, creative work, and inspiration."),
}

ALLOWED = {"png", "jpg", "jpeg", "gif", "webp"}

def db():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con

def initialize():
    with db() as con:
        con.executescript("""
        CREATE TABLE IF NOT EXISTS threads (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            board TEXT NOT NULL,
            name TEXT NOT NULL,
            subject TEXT NOT NULL,
            body TEXT NOT NULL,
            image TEXT,
            created TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS replies (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            thread_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            body TEXT NOT NULL,
            image TEXT,
            created TEXT NOT NULL,
            FOREIGN KEY(thread_id) REFERENCES threads(id)
        );
        """)

initialize()

