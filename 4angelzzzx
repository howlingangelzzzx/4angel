@app.route("/b/<code>", methods=["GET", "POST"])
def board(code):
    if code not in BOARDS:
        abort(404)

    error = None
    if request.method == "POST":
        name = (request.form.get("name") or "Anonymous").strip()[:40] or "Anonymous"
        subject = (request.form.get("subject") or "").strip()[:100]
        body = (request.form.get("body") or "").strip()[:5000]

        if not body:
            error = "Your post cannot be empty."
        else:
            try:
                image = save_image(request.files.get("image"))
                with db() as con:
                    cur = con.execute(
                        """INSERT INTO threads
                        (board, name, subject, body, image, created)
                        VALUES (?, ?, ?, ?, ?, ?)""",
                        (code, name, subject, body, image, now())
                    )
                    thread_id = cur.lastrowid
                return redirect(url_for("thread", thread_id=thread_id))
            except ValueError as e:
                error = str(e)

    with db() as con:
        threads = con.execute(
            "SELECT * FROM threads WHERE board=? ORDER BY id DESC LIMIT 100",
            (code,)
        ).fetchall()

    content = """
    <h2>/{{ code }}/ — {{ info[0] }}</h2>
    <p>{{ info[1] }}</p>
    <div class="panel">
      <h2>Start a thread</h2>
      {% if error %}<p class="error">{{ error }}</p>{% endif %}
      <form method="post" enctype="multipart/form-data">
        <label>Name (optional)</label>
        <input type="text" name="name" maxlength="40" placeholder="Anonymous">
        <label>Subject (optional)</label>
        <input type="text" name="subject" maxlength="100">
        <label>Message</label>
        <textarea name="body" maxlength="5000" required></textarea>
        <label>Image (optional, max 5 MB)</label>
        <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp">
        <button type="submit">Post thread</button>
      </form>
    </div>
    <h2>Threads</h2>
    {% for t in threads %}
      <div class="post">
        <div class="meta">
          {{ t['name'] }} · No.{{ t['id'] }} · {{ t['created'] }}
        </div>
        <h3>{{ t['subject'] or 'Untitled' }}</h3>
        <div class="postbody">{{ t['body'] }}</div>
        {% if t['image'] %}
          <a href="{{ url_for('uploaded_file', filename=t['image']) }}">
            <img class="postimg" loading="lazy"
              src="{{ url_for('uploaded_file', filename=t['image']) }}" alt="Uploaded image">
          </a>
        {% endif %}
        <p><a href="{{ url_for('thread', thread_id=t['id']) }}">Open thread / Reply</a></p>
      </div>
    {% else %}
      <p>No threads here yet.</p>
    {% endfor %}
    """
    return page(
        "Board /" + code + "/", render_template_string(
            content, code=code, info=BOARDS[code],
            threads=threads, error=error
        )
    )

@app.route("/thread/<int:thread_id>", methods=["GET", "POST"])
def thread(thread_id):
    error = None
    with db() as con:
        original = con.execute(
            "SELECT * FROM threads WHERE id=?", (thread_id,)
        ).fetchone()

    if original is None:
        abort(404)

    if request.method == "POST":
        name = (request.form.get("name") or "Anonymous").strip()[:40] or "Anonymous"
        body = (request.form.get("body") or "").strip()[:5000]

        if not body:
            error = "Your reply cannot be empty."
        else:
            try:
                image = save_image(request.files.get("image"))
                with db() as con:
                    con.execute(
                        """INSERT INTO replies
                        (thread_id, name, body, image, created)
                        VALUES (?, ?, ?, ?, ?)""",
                        (thread_id, name, body, image, now())
                    )
                return redirect(url_for("thread", thread_id=thread_id) + "#replies")
            except ValueError as e:
                error = str(e)

    with db() as con:
        replies = con.execute(
            "SELECT * FROM replies WHERE thread_id=? ORDER BY id ASC",
            (thread_id,)
        ).fetchall()

    content = """
    <p><a href="{{ url_for('board', code=original['board']) }}">
      &lt;&lt; Back to /{{ original['board'] }}/
    </a></p>
    <h2>Thread No.{{ original['id'] }}</h2>
    <div class="post">
      <div class="meta">{{ original['name'] }} · {{ original['created'] }}</div>
      <h3>{{ original['subject'] or 'Untitled' }}</h3>
      <div class="postbody">{{ original['body'] }}</div>
      {% if original['image'] %}
        <a href="{{ url_for('uploaded_file', filename=original['image']) }}">
          <img class="postimg" src="{{ url_for('uploaded_file', filename=original['image']) }}" alt="Uploaded image">
        </a>
      {% endif %}
    </div>
    <h2 id="replies">Replies ({{ replies|length }})</h2>
    {% for r in replies %}
      <div class="reply">
        <div class="meta">{{ r['name'] }} · No.{{ r['id'] }} · {{ r['created'] }}</div>
        <div class="postbody">{{ r['body'] }}</div>
        {% if r['image'] %}
          <a href="{{ url_for('uploaded_file', filename=r['image']) }}">
            <img class="postimg" loading="lazy" src="{{ url_for('uploaded_file', filename=r['image']) }}" alt="Uploaded image">
          </a>
        {% endif %}
      </div>
    {% else %}
      <p>No replies yet.</p>
    {% endfor %}
    <div class="panel">
      <h2>Reply</h2>
      {% if error %}<p class="error">{{ error }}</p>{% endif %}
      <form method="post" enctype="multipart/form-data">
        <label>Name (optional)</label>
        <input type="text" name="name" maxlength="40" placeholder="Anonymous">
        <label>Message</label>
        <textarea name="body" maxlength="5000" required></textarea>
        <label>Image (optional, max 5 MB)</label>
        <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp">
        <button type="submit">Reply</button>
      </form>
    </div>
    """
    return page(
        "Thread " + str(thread_id),
        render_template_string(
            content, original=original, replies=replies, error=error
        )
    )

@app.route("/uploads/<path:filename>")
def uploaded_file(filename):
    # Filenames are generated randomly by the application.
    if Path(filename).name != filename:
        abort(404)
    return send_from_directory(UPLOADS, filename, max_age=3600)

@app.errorhandler(404)
def not_found(e):
    return page("Not found", """
      <div class="panel"><h2>404 — Not found</h2>
      <p>That page doesn't exist.</p><p><a href="/">Return home</a></p></div>
    """), 404

@app.errorhandler(413)
def too_large(e):
    return page("File too large", """
      <div class="panel"><h2>Upload too large</h2>
      <p>The request exceeded the 5 MB limit.</p><p><a href="/">Return home</a></p></div>
    """), 413

