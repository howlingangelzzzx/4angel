def page(title, content, **kwargs):
    return render_template_string(
        PAGE, title=title, content=content, style=STYLE,
        boards=BOARDS, **kwargs
    )

def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

def save_image(upload):
    if not upload or not upload.filename:
        return None

    filename = secure_filename(upload.filename)
    if "." not in filename:
        raise ValueError("The image needs a file extension.")

    ext = filename.rsplit(".", 1)[1].lower()
    if ext not in ALLOWED:
        raise ValueError("Allowed formats: PNG, JPG, GIF, and WebP.")

    # Check the actual file signature instead of trusting the extension.
    upload.stream.seek(0)
    header = upload.stream.read(16)
    upload.stream.seek(0)

    signatures = {
        "png": lambda b: b.startswith(b"\\x89PNG\\r\\n\\x1a\\n"),
        "jpg": lambda b: b.startswith(b"\\xff\\xd8\\xff"),
        "jpeg": lambda b: b.startswith(b"\\xff\\xd8\\xff"),
        "gif": lambda b: b.startswith((b"GIF87a", b"GIF89a")),
        "webp": lambda b: len(b) >= 12 and b[:4] == b"RIFF" and b[8:12] == b"WEBP",
    }

    if not signatures[ext](header):
        raise ValueError("The uploaded file does not match its image format.")

    name = secrets.token_hex(16) + "." + ext
    upload.save(UPLOADS / name)
    return name

@app.after_request
def privacy_headers(response):
    # The application does not add visitor IPs to posts or its database.
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["Referrer-Policy"] = "no-referrer"
    response.headers["X-Frame-Options"] = "DENY"
    return response

